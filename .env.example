# X Layer testnet (chain 1952). Nothing here is ever a mainnet key.
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech

# Owns the contracts. Signs deployments and registrations, and nothing on a schedule.
DEPLOYER_PK=0x...
DEPLOYER_ADDR=0x...

# Signs the tape and the marks, every minute, forever. Holds gas and nothing else.
# Keep it separate from the deployer: sharing one account makes the two race for
# the same nonce, and a deploy will fail mid-flight.
KEEPER_PK=0x...
KEEPER_ADDR=0x...
